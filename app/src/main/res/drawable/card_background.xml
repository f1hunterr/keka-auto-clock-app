<?xml version="1.0" encoding="utf-8"?>
<!-- Magic UI "Magic Card" / "Neon Gradient Card" look: a thin gradient-colored
     border around a dark card, built as a gradient rectangle behind a slightly
     inset solid rectangle (native Android has no gradient-stroke support). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="45"
                android:startColor="@color/accent_start"
                android:endColor="@color/accent_end" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:top="1.5dp" android:left="1.5dp" android:right="1.5dp" android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_bg" />
            <corners android:radius="17dp" />
            <padding android:left="20dp" android:top="20dp" android:right="20dp" android:bottom="20dp" />
        </shape>
    </item>
</layer-list>
